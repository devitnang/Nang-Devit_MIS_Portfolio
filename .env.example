# =============================================================================
# Nang Devit Portfolio - Environment Variables Template
# =============================================================================

# Telegram Bot Token (obtained from @BotFather on Telegram)
# TELEGRAM_BOT_TOKEN="set_only_in_your_untracked_.env.local_or_host_secrets"

# Telegram Supergroup ID (starts with -100, e.g. -1001234567890)
# TELEGRAM_GROUP_ID="-100xxxxxxxxxx"

# Telegram Topic ID / Thread ID for forum topics (e.g. 2, 5, 23)
# To find your Topic ID: Right-click the Topic -> "Copy Link" -> the number at the end
# TELEGRAM_TOPIC_ID="your_topic_id_number"

# Base Application URL
NEXT_PUBLIC_SITE_URL="https://www.nangdevit.xyz"

# Contact endpoint security (server-side values must never use NEXT_PUBLIC_)
# List every exact website origin allowed to submit the form.
CONTACT_ALLOWED_ORIGINS="https://www.nangdevit.xyz"

# Header set/overwritten by your trusted hosting proxy with the real client IP.
# On Vercel, x-forwarded-for is overwritten with the client IP.
# For other hosts or proxy chains, confirm the configured header is trusted.
CONTACT_CLIENT_IP_HEADER="x-forwarded-for"

# Required in production for distributed contact-form rate limiting.
# UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# Required in production for Cloudflare Turnstile bot protection.
# Site key is public; secret key stays server-side and must not use NEXT_PUBLIC_.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key_here"
# TURNSTILE_SECRET_KEY="your_turnstile_secret_key_here"
