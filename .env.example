# =============================================================================
# Nang Devit Portfolio - Environment Variables Template
# =============================================================================

# Telegram Bot Token (obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Telegram Supergroup ID (starts with -100, e.g. -1001234567890)
TELEGRAM_GROUP_ID="-100xxxxxxxxxx"

# Telegram Topic ID / Thread ID for forum topics (e.g. 2, 5, 23)
# To find your Topic ID: Right-click the Topic -> "Copy Link" -> the number at the end
TELEGRAM_TOPIC_ID="your_topic_id_number"

# Base Application URL
NEXT_PUBLIC_SITE_URL="https://www.nangdevit.xyz"
