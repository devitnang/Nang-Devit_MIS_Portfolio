# =============================================================================
# Nang Devit Portfolio - Environment Variables Template
# =============================================================================
# IMPORTANT SECURITY NOTICE:
# - Never commit real credentials or .env.local to public version control.
# - Copy this file to .env.local for local development.
# - Add these environment variables in your Vercel Project Settings for production.
# =============================================================================

# Telegram Bot Token (obtained from @BotFather on Telegram)
# Format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Telegram Group Chat ID or User Chat ID (obtained via @userinfobot or Rose bot)
# Group Chat IDs are usually negative numbers prefixed with -100 (e.g. -1001234567890)
TELEGRAM_CHAT_ID="your_telegram_group_chat_id_here"

# Base Application URL
NEXT_PUBLIC_SITE_URL="https://www.nangdevit.xyz"
